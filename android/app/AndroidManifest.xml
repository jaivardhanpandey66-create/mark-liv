<?xml version="1.0" encoding="utf-8"?>
<!--
  MARK LIV — Android build.

  First launch asks for one AI provider API key (Qwen/DashScope, OpenRouter,
  Groq, Gemini, Anthropic, or anything OpenAI-compatible). It is asked once and
  sealed with a key held in the Android keystore, so it is never written in the
  clear and is not part of the APK. INTERNET exists for that cloud brain and for
  nothing else.

  Device control deliberately uses ordinary Android intents — dialer, SMS
  composer, alarm clock, maps, camera, settings panels — so the phone still
  shows the user what is about to happen. That is why the app asks for no
  dangerous permissions: no CALL_PHONE, no SEND_SMS, no camera, no overlay, no
  accessibility service. Actions that reach another person are additionally put
  behind a confirm sheet in the UI.

  The bundled Qwen model, the rule core and the whole UI still work with no
  network at all, as the offline fallback brain.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.markliv.app"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!--
      Android 11+ hides other packages by default, which would make
      open_app / list_apps invisible. Declare only the intents actually fired.
    -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
        <intent><action android:name="android.intent.action.SEND" /><data android:mimeType="text/plain" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.bluetooth.adapter.action.REQUEST_ENABLE" /></intent>
        <intent><action android:name="android.bluetooth.adapter.action.REQUEST_DISABLE" /></intent>
        <intent><action android:name="android.settings.panel.action.WIFI" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:theme="@style/MarkLivTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
